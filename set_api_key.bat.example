@echo off
REM ─────────────────────────────────────────────────────────────────────────────
REM  Local secrets for FinTracker. Copy this file to  set_api_key.bat  (same
REM  folder as run.bat) and fill in the values. run.bat loads it automatically.
REM  set_api_key.bat is git-ignored so nothing here is ever committed.
REM ─────────────────────────────────────────────────────────────────────────────

REM 1. Claude API key for AI Portfolio Analysis (https://console.anthropic.com -> API Keys)
set "ANTHROPIC_API_KEY=sk-ant-your-key-here"

REM 2. Login password. REQUIRED before exposing the app to the internet (tunnel).
REM    When set, every page asks for this password. Leave blank/removed for
REM    local-only desktop use with no login. Use a strong password.
set "FINTRACKER_PASSWORD=choose-a-strong-password"

REM 3. Your ngrok static domain, used by run_remote.bat for a stable phone URL.
REM    Create a free one at ngrok.com (Domains), then put it here (no https://).
set "NGROK_DOMAIN=yourname.ngrok-free.dev"

REM 4. Daytona API key for the AI Analyst (runs AI-generated code in a sandbox).
REM    Get one at https://app.daytona.io/dashboard/keys
set "DAYTONA_API_KEY=your-daytona-key"
